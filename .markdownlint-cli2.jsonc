{
  "config": {
    "default": true,
    "MD013": {
      // Line length: don't flag tables or code blocks - wrapping those
      // would break rendering or readability, only check prose paragraphs.
      "line_length": 120,
      "tables": false,
      "code_blocks": false,
    },
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "**/.tmp/**"],
}
