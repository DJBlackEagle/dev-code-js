{
  "name": "@djblackeagle/dev-config-js",
  "version": "0.0.0",
  "description": "Centralized, modular TypeScript, ESLint, Prettier, Markdownlint, Vitest, and Git tooling configuration.",
  "license": "MIT",
  "author": "DJ BlackEagle",
  "homepage": "https://github.com/DJBlackEagle/dev-code-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DJBlackEagle/dev-code-js.git"
  },
  "bugs": {
    "url": "https://github.com/DJBlackEagle/dev-code-js/issues"
  },
  "keywords": [
    "config",
    "typescript",
    "eslint",
    "prettier",
    "vitest"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js",
      "default": "./dist/eslint/index.js"
    },
    "./eslint/*": {
      "types": "./dist/eslint/*.d.ts",
      "import": "./dist/eslint/*.js",
      "default": "./dist/eslint/*.js"
    },
    "./markdownlint": "./dist/markdownlint/index.jsonc",
    "./markdownlint/index.jsonc": "./dist/markdownlint/index.jsonc",
    "./prettier": {
      "types": "./dist/prettier/index.d.ts",
      "import": "./dist/prettier/index.js",
      "default": "./dist/prettier/index.js"
    },
    "./tsconfig/*": "./dist/tsconfig/*",
    "./tsconfig/*.json": "./dist/tsconfig/*.json",
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js",
      "default": "./dist/vitest/index.js"
    },
    "./vitest/*": {
      "types": "./dist/vitest/*.d.ts",
      "import": "./dist/vitest/*.js",
      "default": "./dist/vitest/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "husky",
    "clean": "pnpm run clean:build && pnpm run clean:node && pnpm run clean:coverage",
    "clean:build": "rm -rf dist *.tsbuildinfo",
    "clean:node": "rm -rf node_modules",
    "clean:coverage": "rm -rf coverage",
    "prepublishOnly": "pnpm run clean:build && pnpm run build",
    "build": "tsc -p tsconfig.build.json && pnpm run build:assets",
    "build:assets": "mkdir -p dist/tsconfig dist/markdownlint && cp src/tsconfig/*.json dist/tsconfig/ && cp src/markdownlint/*.jsonc dist/markdownlint/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && markdownlint-cli2",
    "lint:fix": "eslint . --fix && markdownlint-cli2 --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --coverage.enabled --coverage.reporter=text",
    "test:unit": "vitest run src --coverage.enabled --coverage.reporter=text",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "angular-eslint": "^22.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.6",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
