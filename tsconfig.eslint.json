{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    ".lintstagedrc.js",
    "commitlint.config.js",
    "eslint.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
